name = "gmlewis/gzip"

version = "0.34.8"

import {
  "gmlewis/base64@0.16.10",
  "gmlewis/crc32@0.8.17",
  "gmlewis/flate@0.36.8",
  "gmlewis/io@0.23.11",
  "moonbitlang/x@0.4.43",
}

readme = "README.md"

