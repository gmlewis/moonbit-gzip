name = "gmlewis/gzip"

version = "0.34.12"

import {
  "gmlewis/base64@0.16.12",
  "gmlewis/crc32@0.8.17",
  "gmlewis/flate@0.36.12",
  "gmlewis/io@0.23.15",
  "moonbitlang/x@0.5.1",
}

readme = "README.md"

