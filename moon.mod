name = "gmlewis/gzip"

version = "0.34.10"

import {
  "gmlewis/base64@0.16.11",
  "gmlewis/crc32@0.8.17",
  "gmlewis/flate@0.36.10",
  "gmlewis/io@0.23.13",
  "moonbitlang/x@0.4.46",
}

